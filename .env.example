# ============================================================
#  Configuracion del stack Docker de AulaHub.
# ============================================================

# ---- Base de datos (MySQL del contenedor) ----
DB_NAME=aulahub
DB_USER=aulahub
DB_PASSWORD=CAMBIA_ESTE_PASSWORD
DB_ROOT_PASSWORD=CAMBIA_ESTE_ROOT_PASSWORD

# ---- JWT (OBLIGATORIO) ----
# Genera un secreto con:  openssl rand -base64 48
JWT_SECRET=PEGA_AQUI_UN_SECRETO_LARGO_Y_ALEATORIO
# Vigencia del access token en milisegundos (1800000 = 30 min).
JWT_EXPIRATION=1800000

# ---- URL del backend ----
# La usan TANTO el frontend web COMO el APK (misma URL, una sola fuente).
# Es la direccion publica por la que el navegador / celular llegan a la API.
#   Local:    http://localhost:8081/api
#   Servidor: https://sistemasfic.uas.edu.mx/aulahub/api   (la que sirve el proxy)
API_BASE_URL=http://localhost:8081/api

# ---- URL del frontend (para los enlaces del correo de recuperacion) ----
FRONTEND_URL=http://localhost:8081

# ---- CORS: origen(es) del frontend, separados por coma ----
# Debe incluir el dominio web; para el APK Capacitor agrega http(s)://localhost.
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://localhost

# ---- HTTPS / dominio ----
# AulaHub NO maneja HTTPS: corre detras del proxy de la UAS (Apache/Nginx),
# que pone el HTTPS y reparte el trafico hacia el puerto 8081 del frontend.
# Aqui solo pones, en las 3 URLs de arriba, la direccion PUBLICA que sirve ese
# proxy, por ejemplo:
#   API_BASE_URL=https://sistemasfic.uas.edu.mx/aulahub/api
#   FRONTEND_URL=https://sistemasfic.uas.edu.mx/aulahub
#   CORS_ALLOWED_ORIGINS=https://sistemasfic.uas.edu.mx

# ---- Correo via SMTP (OPCIONAL; vacio = no se envian correos) ----
# Apunta al servidor SMTP (el de la institucion, p.ej. el de la UAS).
# MAIL_USERNAME se usa tambien como remitente (from).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Firebase / push movil (OPCIONAL; vacio = push deshabilitado) ----
# Para activarlo: ver el volumen comentado en docker-compose.yml.
FIREBASE_CREDENTIALS=
