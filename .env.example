# ============================================================
#  Configuracion del stack Docker de AulaHub.
# ============================================================

# ---- Base de datos (MySQL del contenedor) ----
DB_NAME=aulahub
DB_USER=aulahub
DB_PASSWORD=CAMBIA_ESTE_PASSWORD
DB_ROOT_PASSWORD=CAMBIA_ESTE_ROOT_PASSWORD

# ---- JWT (OBLIGATORIO) ----
# Genera un secreto con:  openssl rand -base64 48
JWT_SECRET=PEGA_AQUI_UN_SECRETO_LARGO_Y_ALEATORIO
# Vigencia del access token en milisegundos (1800000 = 30 min).
JWT_EXPIRATION=1800000

# ---- URLs publicas (las sirve el proxy de la UAS) ----
# AulaHub NO maneja HTTPS: corre detras del proxy (Apache/Nginx) de la UAS, que
# pone el HTTPS y enruta hacia el puerto 8081. Aqui van las URLs publicas; cambia
# localhost por tu dominio segun el entorno:
#   Local/prueba: http://localhost:8081
#   Produccion:   https://sistemasfic.uas.edu.mx/aulahub

# URL del backend: la usan el frontend web Y el APK (una sola fuente).
API_BASE_URL=http://localhost:8081/api

# URL del frontend: para los enlaces del correo de recuperacion.
FRONTEND_URL=http://localhost:8081

# CORS: origen(es) permitidos, separados por coma.
# Para el APK Capacitor agrega http(s)://localhost.
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://localhost

# ---- Correo via SMTP (OPCIONAL; vacio = no se envian correos) ----
# Apunta al servidor SMTP (el de la institucion, p.ej. el de la UAS).
# MAIL_USERNAME se usa tambien como remitente (from).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Firebase / push movil (OPCIONAL; vacio = push deshabilitado) ----
# Para activarlo: ver el volumen comentado en docker-compose.yml.
FIREBASE_CREDENTIALS=
